# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# ---- required ----
FRED_API_KEY=                 # required: FRED/ALFRED API key (free). Used by `regport smoke` and `regport fetch fred|alfred`.
# ---- optional ----
SHARADAR_API_KEY=             # Sharadar Full History Bundle key (SFP). Default price source; if empty, the local Stooq snapshot.
STOOQ_DIR=/mnt/e/trading-strategy-brainstorm/data/stooq   # owner's Stooq snapshot (through 2026-10-30). Native Windows: E:\trading-strategy-brainstorm\data\stooq
TIINGO_API_KEY=               # optional, normally unneeded: extra cross-check source only.
DATA_ROOT=~/data/regime-portfolio-construction   # WSL only: data root on ext4. Native Windows: leave empty (~ would point to C:)
REGPORT_DATA_DIR=             # optional: root of raw/, interim/, processed/ (empty = DATA_ROOT, or ./data when DATA_ROOT is empty)
REGPORT_RESULTS_DIR=results   # optional: experiment log and run outputs
REGPORT_REPORTS_DIR=reports   # optional: generated tables and figures
REGPORT_LOG_LEVEL=INFO        # optional: DEBUG | INFO | WARNING
REGPORT_HTTP_TIMEOUT_S=30     # optional: per-request timeout for API downloads
REGPORT_N_JOBS=1              # optional: worker processes for grid runs (results are identical for any value)
